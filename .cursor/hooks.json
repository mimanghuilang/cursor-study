{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "cmd /c node .cursor/hooks/guard-shell.js",
        "failClosed": false
      }
    ],
    "afterShellExecution": [
      {
        "command": "cmd /c node .cursor/hooks/audit-shell.js"
      }
    ]
  }
}
